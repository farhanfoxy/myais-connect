# Runtime API connection only. Supply the real value through deployment secrets.
DATABASE_URL=postgresql://app_user:replace_me@localhost:5432/myais
SUPABASE_URL=https://project-ref.supabase.co
# Optional; defaults to authenticated.
SUPABASE_JWT_AUDIENCE=authenticated
# Server-only private Storage configuration. Never expose the service-role key to clients.
SUPABASE_STORAGE_BUCKET=myais-private
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_service_role_key
PORT=3001
HOST=127.0.0.1
