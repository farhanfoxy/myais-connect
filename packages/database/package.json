{
  "name": "@myais/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": { ".": { "types": "./dist/src/index.d.ts", "import": "./dist/src/index.js" } },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "db:generate": "prisma generate",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "migration:dry-run": "node src/migration/base44/run.ts",
    "migration:import": "node src/migration/base44/run.ts"
  },
  "dependencies": {
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0"
  },
  "devDependencies": {
    "@myais/config": "workspace:*",
    "prisma": "7.10.0",
    "dotenv": "17.4.2"
  }
}
