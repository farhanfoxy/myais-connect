generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Canonical role conversion is performed by the future importer:
// user -> APPLICANT, admin -> SYSTEM_ADMINISTRATOR; retain original legacyRole.
// Optional imported blanks must be explicit nulls, not replaced by field defaults.

enum AnnouncementCategory {
  GENERAL
  EVENT
  MEMBERSHIP
  POLICY
  TRAINING
}

enum AnnouncementTargetAudience {
  ALL
  MEMBERS
  APPLICANTS
  COMMITTEE
}

enum AnnouncementStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ApplicationDocumentDocumentType {
  IDENTIFICATION
  AIS_MEMBERSHIP_PROOF
  PROFILE_PHOTO
  PAYMENT_RECEIPT
  ADDITIONAL_SUPPORTING_DOCUMENT
  REQUESTED_INFORMATION
}

enum ApplicationDocumentVerificationStatus {
  PENDING
  VERIFIED
  INVALID
  RESUBMISSION_REQUIRED
}

enum ApplicationReviewDecision {
  START_REVIEW
  REQUEST_INFORMATION
  RECOMMEND_APPROVAL
  APPROVE
  REJECT
  RETURN_FOR_CORRECTION
}

enum EligibilityQuestionInputType {
  BOOLEAN
  DATE
  TEXT
  SELECT
}

enum EventCategory {
  SEMINARS_AND_WEBINARS @map("Seminars and Webinars")
  WORKSHOPS             @map("Workshops")
  MEETINGS              @map("Meetings")
  MYDCIS                @map("MyDCIS")
  CONFERENCES           @map("Conferences")
  OTHER                 @map("Other")
}

enum EventVenueType {
  PHYSICAL
  ONLINE
  HYBRID
}

enum EventStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  CANCELLED
  COMPLETED
  ARCHIVED
}

enum EventTargetAudience {
  MEMBERS
  NON_MEMBERS
  MEMBERS_AND_NON_MEMBERS
}

enum EventRegistrationStatus {
  REGISTERED
  CANCELLED
  ATTENDED
  NO_SHOW
}

enum EventRegistrationPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
}

enum InformationRequestStatus {
  OPEN
  RESPONDED
  RESOLVED
  OVERDUE
}

enum MemberProfileIdentificationType {
  NRIC
  PASSPORT
  OTHER
}

enum MemberProfileGender {
  MALE
  FEMALE
  OTHER
}

enum MembershipStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  TERMINATED
}

enum MembershipApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ADDITIONAL_INFORMATION_REQUIRED
  ELIGIBLE
  RECOMMENDED_FOR_APPROVAL
  APPROVED_PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_UNDER_VERIFICATION
  ACTIVE
  REJECTED
  EXPIRED
  SUSPENDED
  TERMINATED
}

enum MembershipTypeCode {
  ORDINARY
  LIFETIME
  ASSOCIATE
  HONORARY
}

enum NotificationType {
  APPLICATION
  PAYMENT
  MEMBERSHIP
  ANNOUNCEMENT
  SYSTEM
}

enum PaymentPaymentType {
  ENTRANCE_AND_ANNUAL
  ENTRANCE_AND_LIFETIME
  RENEWAL
  OTHER
}

enum PaymentStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_VERIFICATION
  VERIFIED
  REJECTED
}

enum RenewalApplicationStatus {
  PENDING
  PAYMENT_SUBMITTED
  APPROVED
  REJECTED
}

enum SystemSettingSettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
}

enum UserRole {
  APPLICANT
  ORDINARY_MEMBER
  LIFETIME_MEMBER
  ASSOCIATE_MEMBER
  HONORARY_MEMBER
  PRESIDENT
  DEPUTY_PRESIDENT
  SECRETARY
  ASSISTANT_SECRETARY
  TREASURER
  COMMITTEE_MEMBER
  SYSTEM_ADMINISTRATOR
}

enum UserAccountStatus {
  ACTIVE
  DISABLED
  SUSPENDED
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  role                  UserRole?          @default(APPLICANT)
  phoneNumber           String?
  photoUrl              String?
  profilePhotoObjectKey String?            @unique
  accountStatus         UserAccountStatus? @default(ACTIVE)
  lastLoginAt           DateTime?          @db.Timestamptz(3)
  email                 String?            @unique
  supabaseAuthUserId    String?            @unique @db.Uuid
  legacyFullName        String?
  fullName              String?
  legacyRole            String?
  legacyPlatformStatus  String?

  announcementRecordsByCreatedByUser           Announcement[]          @relation("Announcement_createdByUserId")
  applicationDocumentRecordsByUser             ApplicationDocument[]   @relation("ApplicationDocument_userId")
  applicationDocumentRecordsByVerifiedByUser   ApplicationDocument[]   @relation("ApplicationDocument_verifiedByUserId")
  applicationReviewRecordsByReviewerUser       ApplicationReview[]     @relation("ApplicationReview_reviewerUserId")
  auditLogRecordsByActorUser                   AuditLog[]              @relation("AuditLog_actorUserId")
  eligibilityAnswerRecordsByUser               EligibilityAnswer[]     @relation("EligibilityAnswer_userId")
  eventRecordsByCreatedByUser                  Event[]                 @relation("Event_createdByUserId")
  eventRegistrationRecordsByUser               EventRegistration[]     @relation("EventRegistration_userId")
  informationRequestRecordsByRequestedByUser   InformationRequest[]    @relation("InformationRequest_requestedByUserId")
  memberProfileByUser                          MemberProfile?          @relation("MemberProfile_userId")
  membershipRecordsByUser                      Membership[]            @relation("Membership_userId")
  membershipApplicationRecordsByUser           MembershipApplication[] @relation("MembershipApplication_userId")
  membershipApplicationRecordsByReviewedByUser MembershipApplication[] @relation("MembershipApplication_reviewedByUserId")
  membershipApplicationRecordsByApprovedByUser MembershipApplication[] @relation("MembershipApplication_approvedByUserId")
  notificationRecordsByUser                    Notification[]          @relation("Notification_userId")
  paymentRecordsByUser                         Payment[]               @relation("Payment_userId")
  paymentRecordsByVerifiedByUser               Payment[]               @relation("Payment_verifiedByUserId")
  renewalApplicationRecordsByUser              RenewalApplication[]    @relation("RenewalApplication_userId")
  systemSettingRecordsByUpdatedByUser          SystemSetting[]         @relation("SystemSetting_updatedByUserId")
}

model MemberProfile {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  userId                      String                           @unique @db.Uuid
  fullName                    String?
  phoneNumber                 String?
  identificationType          MemberProfileIdentificationType?
  identificationNumber        String?
  nationality                 String?
  dateOfBirth                 DateTime?                        @db.Date
  gender                      MemberProfileGender?
  addressLine1                String?
  addressLine2                String?
  city                        String?
  state                       String?
  postcode                    String?
  country                     String?
  institution                 String?
  occupation                  String?
  department                  String?
  areaOfExpertise             String?
  aisMember                   Boolean?                         @default(false)
  aisMembershipNumber         String?
  aisMembershipExpiry         DateTime?                        @db.Date
  profileCompletionPercentage Float?                           @default(0)
  legacyCreatedById           String?
  legacyCreatedBy             String?
  legacyIsSample              Boolean?

  user User @relation("MemberProfile_userId", fields: [userId], references: [id], onDelete: Restrict)
}

model MembershipType {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  code                MembershipTypeCode @unique
  name                String
  description         String?
  entranceFee         Decimal?           @default(0) @db.Decimal(12, 2)
  membershipFee       Decimal?           @default(0) @db.Decimal(12, 2)
  validityMonths      Float?             @default(12)
  renewable           Boolean?           @default(true)
  votingRights        Boolean?           @default(false)
  applicantSelectable Boolean?           @default(true)
  active              Boolean?           @default(true)
  legacyCreatedById   String?
  legacyCreatedBy     String?
  legacyIsSample      Boolean?

  membershipRecordsByMembershipType                       Membership[]            @relation("Membership_membershipTypeId")
  membershipApplicationRecordsByRequestedMembershipType   MembershipApplication[] @relation("MembershipApplication_requestedMembershipTypeId")
  membershipApplicationRecordsByRecommendedMembershipType MembershipApplication[] @relation("MembershipApplication_recommendedMembershipTypeId")
  membershipApplicationRecordsByApprovedMembershipType    MembershipApplication[] @relation("MembershipApplication_approvedMembershipTypeId")
}

model MembershipApplication {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  applicationNumber             String?                      @unique
  userId                        String                       @db.Uuid
  requestedMembershipTypeId     String?                      @db.Uuid
  recommendedMembershipTypeId   String?                      @db.Uuid
  approvedMembershipTypeId      String?                      @db.Uuid
  status                        MembershipApplicationStatus? @default(DRAFT)
  currentStep                   Float?                       @default(1)
  eligibilityScore              Float?
  eligibilityExplanation        String?
  submittedAt                   DateTime?                    @db.Timestamptz(3)
  reviewedAt                    DateTime?                    @db.Timestamptz(3)
  approvedAt                    DateTime?                    @db.Timestamptz(3)
  rejectedAt                    DateTime?                    @db.Timestamptz(3)
  rejectionReason               String?
  latestReviewerRemarks         String?
  reviewedByUserId              String?                      @db.Uuid
  approvedByUserId              String?                      @db.Uuid
  requestedMembershipTypeCode   String?
  recommendedMembershipTypeCode String?
  approvedMembershipTypeCode    String?
  legacyCreatedById             String?
  legacyCreatedBy               String?
  legacyIsSample                Boolean?

  user                                    User                  @relation("MembershipApplication_userId", fields: [userId], references: [id], onDelete: Restrict)
  requestedMembershipType                 MembershipType?       @relation("MembershipApplication_requestedMembershipTypeId", fields: [requestedMembershipTypeId], references: [id], onDelete: Restrict)
  recommendedMembershipType               MembershipType?       @relation("MembershipApplication_recommendedMembershipTypeId", fields: [recommendedMembershipTypeId], references: [id], onDelete: Restrict)
  approvedMembershipType                  MembershipType?       @relation("MembershipApplication_approvedMembershipTypeId", fields: [approvedMembershipTypeId], references: [id], onDelete: Restrict)
  reviewedByUser                          User?                 @relation("MembershipApplication_reviewedByUserId", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  approvedByUser                          User?                 @relation("MembershipApplication_approvedByUserId", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  applicationDocumentRecordsByApplication ApplicationDocument[] @relation("ApplicationDocument_applicationId")
  applicationReviewRecordsByApplication   ApplicationReview[]   @relation("ApplicationReview_applicationId")
  eligibilityAnswerRecordsByApplication   EligibilityAnswer[]   @relation("EligibilityAnswer_applicationId")
  informationRequestRecordsByApplication  InformationRequest[]  @relation("InformationRequest_applicationId")
  membershipByApplication                 Membership?           @relation("Membership_applicationId")
  paymentByApplication                    Payment?              @relation("Payment_applicationId")

  @@index([userId])
  @@index([requestedMembershipTypeId])
  @@index([recommendedMembershipTypeId])
  @@index([approvedMembershipTypeId])
  @@index([reviewedByUserId])
  @@index([approvedByUserId])
}

model EligibilityQuestion {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  code              String                       @unique
  question          String
  inputType         EligibilityQuestionInputType
  options           String?
  displayOrder      Float?
  required          Boolean?                     @default(true)
  active            Boolean?                     @default(true)
  ordinaryRule      String?
  lifetimeRule      String?
  legacyCreatedById String?
  legacyCreatedBy   String?
  legacyIsSample    Boolean?

  eligibilityAnswerRecordsByQuestion EligibilityAnswer[] @relation("EligibilityAnswer_questionId")
}

model EligibilityAnswer {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  applicationId String   @db.Uuid
  questionId    String   @db.Uuid
  userId        String   @db.Uuid
  questionCode  String?
  answerText    String?
  answerBoolean Boolean?
  answerOption  String?

  application MembershipApplication @relation("EligibilityAnswer_applicationId", fields: [applicationId], references: [id], onDelete: Restrict)
  question    EligibilityQuestion   @relation("EligibilityAnswer_questionId", fields: [questionId], references: [id], onDelete: Restrict)
  user        User                  @relation("EligibilityAnswer_userId", fields: [userId], references: [id], onDelete: Restrict)

  @@index([applicationId])
  @@index([questionId])
  @@index([userId])
}

model ApplicationDocument {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  applicationId      String                                 @db.Uuid
  userId             String                                 @db.Uuid
  documentType       ApplicationDocumentDocumentType
  fileUrl            String?
  storageObjectKey   String?                                @unique
  originalFileName   String?
  mimeType           String?
  fileSize           Float?
  verificationStatus ApplicationDocumentVerificationStatus? @default(PENDING)
  reviewerRemarks    String?
  verifiedByUserId   String?                                @db.Uuid
  verifiedAt         DateTime?                              @db.Timestamptz(3)
  legacyCreatedById  String?
  legacyCreatedBy    String?
  legacyIsSample     Boolean?

  application    MembershipApplication @relation("ApplicationDocument_applicationId", fields: [applicationId], references: [id], onDelete: Restrict)
  user           User                  @relation("ApplicationDocument_userId", fields: [userId], references: [id], onDelete: Restrict)
  verifiedByUser User?                 @relation("ApplicationDocument_verifiedByUserId", fields: [verifiedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([userId])
  @@index([verifiedByUserId])
}

model ApplicationReview {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  applicationId     String                    @db.Uuid
  reviewerUserId    String?                   @db.Uuid
  reviewerName      String?
  decision          ApplicationReviewDecision
  remarks           String?
  previousStatus    String?
  newStatus         String?
  legacyCreatedById String?
  legacyCreatedBy   String?
  legacyIsSample    Boolean?

  application  MembershipApplication @relation("ApplicationReview_applicationId", fields: [applicationId], references: [id], onDelete: Restrict)
  reviewerUser User?                 @relation("ApplicationReview_reviewerUserId", fields: [reviewerUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([reviewerUserId])
}

model InformationRequest {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  applicationId               String                    @db.Uuid
  requestedByUserId           String?                   @db.Uuid
  requestedByName             String?
  message                     String
  dueDate                     DateTime?                 @db.Date
  status                      InformationRequestStatus? @default(OPEN)
  applicantResponse           String?
  responseAttachmentUrl       String?
  responseAttachmentObjectKey String?                   @unique
  respondedAt                 DateTime?                 @db.Timestamptz(3)

  application     MembershipApplication @relation("InformationRequest_applicationId", fields: [applicationId], references: [id], onDelete: Restrict)
  requestedByUser User?                 @relation("InformationRequest_requestedByUserId", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@index([applicationId])
  @@index([requestedByUserId])
}

model Membership {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  membershipNumber   String?           @unique
  userId             String            @db.Uuid
  applicationId      String?           @unique @db.Uuid
  membershipTypeId   String            @db.Uuid
  membershipTypeCode String?
  membershipTypeName String?
  startDate          DateTime?         @db.Date
  expiryDate         DateTime?         @db.Date
  status             MembershipStatus? @default(PENDING)
  votingEligible     Boolean?          @default(false)
  activatedAt        DateTime?         @db.Timestamptz(3)
  suspendedAt        DateTime?         @db.Timestamptz(3)
  terminatedAt       DateTime?         @db.Timestamptz(3)
  legacyCreatedById  String?
  legacyCreatedBy    String?
  legacyIsSample     Boolean?

  user                                  User                   @relation("Membership_userId", fields: [userId], references: [id], onDelete: Restrict)
  application                           MembershipApplication? @relation("Membership_applicationId", fields: [applicationId], references: [id], onDelete: Restrict)
  membershipType                        MembershipType         @relation("Membership_membershipTypeId", fields: [membershipTypeId], references: [id], onDelete: Restrict)
  paymentRecordsByMembership            Payment[]              @relation("Payment_membershipId")
  renewalApplicationRecordsByMembership RenewalApplication[]   @relation("RenewalApplication_membershipId")

  @@index([userId])
  @@index([membershipTypeId])
}

model Payment {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  paymentReference     String?            @unique
  userId               String             @db.Uuid
  applicationId        String?            @unique @db.Uuid
  membershipId         String?            @db.Uuid
  paymentType          PaymentPaymentType
  entranceFee          Decimal?           @default(0) @db.Decimal(12, 2)
  membershipFee        Decimal?           @default(0) @db.Decimal(12, 2)
  totalAmount          Decimal            @default(0) @db.Decimal(12, 2)
  currency             String?            @default("MYR")
  paymentMethod        String?
  bankName             String?
  transactionReference String?
  receiptUrl           String?
  receiptObjectKey     String?            @unique
  status               PaymentStatus?     @default(NOT_SUBMITTED)
  paidAt               DateTime?          @db.Timestamptz(3)
  submittedAt          DateTime?          @db.Timestamptz(3)
  verifiedByUserId     String?            @db.Uuid
  verifiedAt           DateTime?          @db.Timestamptz(3)
  rejectionReason      String?
  treasurerRemarks     String?
  legacyCreatedById    String?
  legacyCreatedBy      String?
  legacyIsSample       Boolean?

  user                               User                   @relation("Payment_userId", fields: [userId], references: [id], onDelete: Restrict)
  application                        MembershipApplication? @relation("Payment_applicationId", fields: [applicationId], references: [id], onDelete: Restrict)
  membership                         Membership?            @relation("Payment_membershipId", fields: [membershipId], references: [id], onDelete: Restrict)
  verifiedByUser                     User?                  @relation("Payment_verifiedByUserId", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  renewalApplicationRecordsByPayment RenewalApplication[]   @relation("RenewalApplication_paymentId")

  @@index([userId])
  @@index([membershipId])
  @@index([verifiedByUserId])
}

model RenewalApplication {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  renewalNumber      String?
  membershipId       String                    @db.Uuid
  userId             String                    @db.Uuid
  previousExpiryDate DateTime?                 @db.Date
  newExpiryDate      DateTime?                 @db.Date
  fee                Decimal?                  @db.Decimal(12, 2)
  status             RenewalApplicationStatus? @default(PENDING)
  submittedAt        DateTime?                 @db.Timestamptz(3)
  paymentId          String?                   @db.Uuid
  approvedAt         DateTime?                 @db.Timestamptz(3)

  membership Membership @relation("RenewalApplication_membershipId", fields: [membershipId], references: [id], onDelete: Restrict)
  user       User       @relation("RenewalApplication_userId", fields: [userId], references: [id], onDelete: Restrict)
  payment    Payment?   @relation("RenewalApplication_paymentId", fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([membershipId])
  @@index([userId])
  @@index([paymentId])
}

model Event {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  eventNumber             String?              @unique
  title                   String
  slug                    String?
  category                EventCategory
  summary                 String?
  description             String
  coverImage              String?
  speakerName             String?
  speakerTitle            String?
  eventType               String?
  venueType               EventVenueType
  venueName               String?
  physicalAddress         String?
  onlineMeetingUrl        String?
  startDate               DateTime             @db.Date
  startTime               String
  endDate                 DateTime?            @db.Date
  endTime                 String?
  registrationStart       DateTime?            @db.Date
  registrationDeadline    DateTime?            @db.Date
  capacity                Float?
  limitedSeats            Boolean?             @default(false)
  memberFee               Decimal?             @default(0) @db.Decimal(12, 2)
  nonMemberFee            Decimal?             @default(0) @db.Decimal(12, 2)
  currency                String?              @default("MYR")
  paymentInstructions     String?
  registrationUrl         String?
  status                  EventStatus?         @default(DRAFT)
  targetAudience          EventTargetAudience? @default(MEMBERS_AND_NON_MEMBERS)
  createdByUserId         String?              @db.Uuid
  legacyCreatedBy         String?
  publishedAt             DateTime?            @db.Timestamptz(3)
  cancelledAt             DateTime?            @db.Timestamptz(3)
  cancellationReason      String?
  placeholderImageNotice  Boolean?             @default(false)
  legacyCreatedById       String?
  // Base44 created_by; distinct from business createdBy -> legacyCreatedBy.
  legacyPlatformCreatedBy String?
  legacyIsSample          Boolean?
  timezone                String               @default("Asia/Kuala_Lumpur")

  createdByUser                   User?               @relation("Event_createdByUserId", fields: [createdByUserId], references: [id], onDelete: SetNull)
  eventRegistrationRecordsByEvent EventRegistration[] @relation("EventRegistration_eventId")

  @@index([createdByUserId])
}

model EventRegistration {
  id              String    @id @default(uuid()) @db.Uuid
  legacyBase44Id  String?   @unique
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  legacyCreatedAt DateTime? @db.Timestamptz(3)
  legacyUpdatedAt DateTime? @db.Timestamptz(3)

  eventId       String                          @db.Uuid
  userId        String                          @db.Uuid
  attendeeName  String?
  attendeeEmail String?
  status        EventRegistrationStatus?        @default(REGISTERED)
  paymentStatus EventRegistrationPaymentStatus? @default(PENDING)
  registeredAt  DateTime?                       @db.Timestamptz(3)
  notes         String?

  event Event @relation("EventRegistration_eventId", fields: [eventId], references: [id], onDelete: Restrict)
  user  User  @relation("EventRegistration_userId", fields: [userId], references: [id], onDelete: Restrict)

